import sys
import os
import json
import duckdb
import numpy as np
import joblib
from sklearn.linear_model import LogisticRegression

def main():
    # Read input payload
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        payload = json.load(f)
    
    root = payload['root']
    run_dir = payload['run_dir']
    context = payload['context']
    operator_params = payload['operator']['params']
    
    # Get paths and contracts
    dataset_contract = context['dataset_contract']
    labeled_train_path = os.path.join(run_dir, "labeled_train.jsonl")
    embedding_file_path = os.path.join(root, dataset_contract['embedding_file'])
    join_key_left = dataset_contract['embedding_join_key'].split(' -> ')[0]
    embedding_col = dataset_contract['embedding_column']
    
    # Read labeled training data
    embedding_ids = []
    labels = []
    with open(labeled_train_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            row = json.loads(line)
            # Traverse to get embedding id from nested structure
            current = row
            for key_part in join_key_left.split('.'):
                current = current[key_part]
            embedding_ids.append(current)
            labels.append(int(row['label']))
    
    # Load matching embeddings from parquet
    conn = duckdb.connect(database=':memory:')
    placeholders = ','.join(['?'] * len(embedding_ids))
    query = f"""
        SELECT embedding_id, {embedding_col}
        FROM read_parquet('{embedding_file_path}')
        WHERE embedding_id IN ({placeholders})
    """
    embeddings_df = conn.execute(query, embedding_ids).df()
    
    # Align embeddings to the order of training samples
    embedding_dict = {
        row['embedding_id']: np.array(row[embedding_col]) 
        for _, row in embeddings_df.iterrows()
    }
    X = np.array([embedding_dict[eid] for eid in embedding_ids])
    y = np.array(labels)
    
    # Initialize and train model
    proxy_model_conf = operator_params['proxy_model']
    model_name = proxy_model_conf['name']
    hyperparams = proxy_model_conf['hyperparameters']
    
    if model_name == "LogisticRegression":
        model = LogisticRegression(**hyperparameters)
    else:
        raise ValueError(f"Unsupported proxy model: {model_name}")
    
    model.fit(X, y)
    
    # Save trained model to run directory
    output_model_path = os.path.join(run_dir, "proxy_model.joblib")
    joblib.dump(model, output_model_path)
    
    # Prepare output observation
    observation = {
        "status": "success",
        "training_rows": len(X),
        "model_file": output_model_path,
        "proxy_model": model_name,
        "hyperparameters": hyperparams,
        "nl_description": f"Trained Logistic Regression model on {len(X)} labeled samples with embeddings"
    }
    
    # Print observation to stdout
    print(json.dumps(observation))

if __name__ == "__main__":
    main()
