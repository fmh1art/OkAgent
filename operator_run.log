<code>import sys
import json
import os
import random

def main():
    payload = json.load(open(sys.argv[1], encoding='utf-8'))
    root = payload['root']
    run_dir = payload['run_dir']
    
    # Load full dataset
    full_path = os.path.join(root, 'full.jsonl')
    all_data = []
    with open(full_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if line:
                all_data.append(json.loads(line))
    
    # Stratified split by label
    label_0 = [d for d in all_data if d['label'] == 0]
    label_1 = [d for d in all_data if d['label'] == 1]
    
    random.seed(42)
    random.shuffle(label_0)
    random.shuffle(label_1)
    
    test_size = 0.2
    n_test0 = int(len(label_0) * test_size)
    n_test1 = round(len(label_1) * test_size)
    
    train = label_0[n_test0:] + label_1[n_test1:]
    test = label_0[:n_test0] + label_1[:n_test1]
    
    # Write outputs to run_dir
    train_file = os.path.join(run_dir, 'train.jsonl')
    with open(train_file, 'w', encoding='utf-8') as f:
        for row in train:
            f.write(json.dumps(row) + '\n')
    
    test_file = os.path.join(run_dir, 'test.jsonl')
    with open(test_file, 'w', encoding='utf-8') as f:
        for row in test:
            f.write(json.dumps(row) + '\n')
    
    # Prepare observation
    observation = {
        "partition_method": "stratified",
        "train_files": ["train.jsonl"],
        "train_rows": len(train),
        "test_files": ["test.jsonl"],
        "test_rows": len(test),
        "total_rows": len(train) + len(test)
    }
    
    print(json.dumps(observation))

if __name__ == "__main__":
    main()
