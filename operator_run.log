<code>import sys
import json
import os
import duckdb
import numpy as np
from sklearn.linear_model import LogisticRegression
import joblib

def main():
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        payload = json.load(f)
    
    root = payload['root']
    run_dir = payload['run_dir']
    operator = payload['operator']
    context = payload['context']
    dataset_contract = context['dataset_contract']

    # Define paths
    labeled_train_path = os.path.join(run_dir, 'labeled_train.jsonl')
    embedding_file = os.path.join(root, dataset_contract['embedding_file'])
    join_key = dataset_contract['embedding_join_key'].split(' -> ')[1]
    embedding_col = dataset_contract['embedding_column']
    label_col = dataset_contract['existing_label']

    # Read labeled data: get embedding IDs and labels
    embedding_ids = []
    labels = []
    with open(labeled_train_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            row = json.loads(line)
            e_id = row['attributes']['unstructured']['embedding_id']
            y = row[label_col]
            embedding_ids.append(e_id)
            labels.append(y)

    # Load embeddings from parquet
    con = duckdb.connect()
    emb_df = con.execute(
        f"SELECT {join_key}, {embedding_col} FROM read_parquet('{embedding_file}') WHERE {join_key} IN {tuple(embedding_ids)}"
    ).fetchdf()

    # Align embeddings to label order
    emb_map = {row[join_key]: np.array(row[embedding_col]) for _, row in emb_df.iterrows()}
    X = np.stack([emb_map[eid] for eid in embedding_ids])
    y = np.array(labels)

    # Initialize and train model
    proxy_config = operator['params']['proxy_model']
    hyperparams = proxy_config['hyperparameters']
    model = LogisticRegression(**hyperparams)
    model.fit(X, y)

    # Save model to run directory
    model_output_path = os.path.join(run_dir, 'trained_proxy_model.joblib')
    joblib.dump(model, model_output_path)

    # Prepare output observation
    observation = {
        "status": "success",
        "model_file": model_output_path,
        "trained_samples": len(X),
        "model_name": proxy_config['name'],
        "nl_description": f"Trained LogisticRegression model with class_weight balanced on {len(X)} labeled samples using precomputed embeddings"
    }

    print(json.dumps(observation))

if __name__ == "__main__":
    main()</code>
