import sys
import json
import os
import numpy as np
import duckdb
from sklearn.linear_model import LogisticRegression
import joblib

def main():
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        payload = json.load(f)
    
    root = payload['root']
    run_dir = payload['run_dir']
    context = payload['context']
    operator = payload['operator']
    
    proxy_params = operator['params']['proxy_model']
    model_name = proxy_params['name']
    hyperparams = proxy_params['hyperparameters']
    
    labeled_train_path = os.path.join(run_dir, 'labeled_train.jsonl')
    samples = []
    with open(labeled_train_path, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            samples.append(json.loads(line))
    
    embedding_ids = []
    y = []
    for sample in samples:
        eid = sample['attributes']['unstructured']['embedding_id']
        embedding_ids.append(eid)
        y.append(sample['proxy_label'])
    
    dataset_contract = context['dataset_contract']
    embedding_file = dataset_contract['embedding_file']
    embedding_path = os.path.join(root, embedding_file)
    
    con = duckdb.connect()
    df = con.execute(
        "SELECT embedding_id, embedding FROM read_parquet('{}') WHERE embedding_id IN (SELECT unnest(?))"
        .format(embedding_path.replace("'", "''")),
        [embedding_ids]
    ).fetchdf()
    
    embedding_map = {row['embedding_id']: np.array(row['embedding']) for _, row in df.iterrows()}
    X = np.array([embedding_map[eid] for eid in embedding_ids])
    y = np.array(y)
    
    if model_name == 'LogisticRegression':
        model = LogisticRegression(**hyperparams)
    else:
        raise ValueError(f"Unsupported proxy model: {model_name}")
    
    model.fit(X, y)
    
    model_output_path = os.path.join(run_dir, 'proxy_model.joblib')
    joblib.dump(model, model_output_path)
    
    observation = {
        "status": "success",
        "train_rows": len(samples),
        "model_file": model_output_path,
        "proxy_model": model_name,
        "nl_description": f"Trained {model_name} proxy model on {len(samples)} training samples using embeddings"
    }
    
    print(json.dumps(observation))

if __name__ == "__main__":
    main()
