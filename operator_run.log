<code>import sys
import json
import os
import glob
import joblib
import duckdb
import numpy as np

def main():
    with open(sys.argv[1], 'r', encoding='utf-8') as f:
        payload = json.load(f)
    root = payload['root']
    run_dir = payload['run_dir']
    dataset_contract = payload['context']['dataset_contract']

    # Load trained model
    model_file = os.path.join(run_dir, 'proxy_model.joblib')
    model = joblib.load(model_file)

    # Read all test samples
    test_glob_pattern = os.path.join(root, dataset_contract['test_glob'])
    test_files = glob.glob(test_glob_pattern)
    test_samples = []
    for f_path in test_files:
        with open(f_path, 'r', encoding='utf-8') as f:
            for line in f:
                stripped = line.strip()
                if stripped:
                    test_samples.append(json.loads(stripped))
    test_rows = len(test_samples)

    if test_rows == 0:
        obs = {
            "status": "success",
            "precision": 0.0,
            "recall": 0.0,
            "f1": 0.0,
            "tp": 0, "fp": 0, "fn": 0, "tn": 0,
            "test_rows": 0,
            "model_file": model_file,
            "nl_description": "候选人适配分类"
        }
        print(json.dumps(obs, ensure_ascii=False))
        return

    # Collect embedding ids and true labels
    embedding_ids = []
    y_true = []
    for sample in test_samples:
        eid = sample['attributes']['unstructured']['embedding_id']
        embedding_ids.append(eid)
        y_true.append(sample['label'])
    y_true = np.array(y_true, dtype=int)

    # Load embeddings from parquet
    embedding_path = os.path.join(root, dataset_contract['embedding_file'])
    con = duckdb.connect(database=':memory:')
    placeholders = ', '.join(['?'] * len(embedding_ids))
    query = f"SELECT embedding_id, embedding FROM read_parquet('{embedding_path}') WHERE embedding_id IN ({placeholders})"
    result = con.execute(query, embedding_ids).fetchall()
    emb_map = {row[0]: np.array(row[1]) for row in result}
    X = np.array([emb_map[eid] for eid in embedding_ids])
    con.close()

    # Predict
    y_pred = model.predict(X)
    y_pred = np.array(y_pred, dtype=int)

    # Calculate confusion matrix values
    tp = int(np.sum((y_pred == 1) & (y_true == 1)))
    tn = int(np.sum((y_pred == 0) & (y_true == 0)))
    fp = int(np.sum((y_pred == 1) & (y_true == 0)))
    fn = int(np.sum((y_pred == 0) & (y_true == 1)))

    # Calculate metrics
    precision = float(tp) / (tp + fp) if (tp + fp) > 0 else 0.0
    recall = float(tp) / (tp + fn) if (tp + fn) > 0 else 0.0
    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0

    # Write predictions to run directory
    output_path = os.path.join(run_dir, 'test_with_pred.jsonl')
    with open(output_path, 'w', encoding='utf-8') as f_out:
        for sample, pred in zip(test_samples, y_pred):
            sample['predicted_adaptation'] = int(pred)
            f_out.write(json.dumps(sample, ensure_ascii=False) + '\n')

    # Prepare output observation
    observation = {
        "status": "success",
        "precision": precision,
        "recall": recall,
        "f1": f1,
        "tp": tp,
        "fp": fp,
        "fn": fn,
        "tn": tn,
        "test_rows": test_rows,
        "model_file": model_file,
        "nl_description": "候选人适配分类"
    }

    print(json.dumps(observation, ensure_ascii=False))

if __name__ == "__main__":
    main()
