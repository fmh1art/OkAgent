<code>import sys
import json
import os
import glob
import random

def main():
    payload_path = sys.argv[1]
    with open(payload_path, 'r', encoding='utf-8') as f:
        payload = json.load(f)
    
    root = payload['root']
    run_dir = payload['run_dir']
    operator_params = payload['operator']['params']
    context = payload['context']
    
    sample_method = operator_params['sample_method']
    sample_number = int(operator_params['sample_number'])
    train_glob_pattern = context['dataset_contract']['train_glob']
    
    # Collect all train data lines
    all_train_rows = []
    train_file_paths = glob.glob(os.path.join(root, train_glob_pattern))
    for file_path in train_file_paths:
        with open(file_path, 'r', encoding='utf-8') as f:
            for line in f:
                stripped_line = line.strip()
                if not stripped_line:
                    continue
                all_train_rows.append(json.loads(stripped_line))
    
    original_row_count = len(all_train_rows)
    
    # Perform sampling
    if sample_method == 'all_train':
        sampled_rows = all_train_rows
    else: # downsample
        if len(all_train_rows) <= sample_number:
            sampled_rows = all_train_rows
        else:
            sampled_rows = random.sample(all_train_rows, sample_number)
    
    # Write output to run_dir
    output_file_path = os.path.join(run_dir, 'sampled_train.jsonl')
    with open(output_file_path, 'w', encoding='utf-8') as out_f:
        for row in sampled_rows:
            out_f.write(json.dumps(row, ensure_ascii=False) + '\n')
    
    # Prepare output observation
    observation = {
        "status": "success",
        "original_train_rows": original_row_count,
        "output_sampled_rows": len(sampled_rows),
        "output_file": output_file_path,
        "sample_method": sample_method,
        "requested_sample_number": sample_number
    }
    
    print(json.dumps(observation, ensure_ascii=False))

if __name__ == "__main__":
    main()</code>
